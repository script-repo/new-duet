# Copy to .env (git-ignored). Tandem reads TANDEM_* settings and provider keys from here.
# TANDEM_PORT=8000
# TANDEM_HOST=127.0.0.1
# TANDEM_DATA_DIR=./data
# TANDEM_DATABASE_URL=postgresql+psycopg://tandem:tandem@localhost:5432/tandem
# TANDEM_AUTH_TOKEN=change-me-to-a-long-random-string
# TANDEM_CONFIG=./tandem.yaml
# TANDEM_MOCK=true
# TANDEM_TIMEZONE=America/Toronto
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# NAI_API_KEY=
